# Copie este arquivo para .env e preencha os valores

# Servidor
PORT=3333
NODE_ENV=development
# Origens liberadas para o front-end (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5500

# Banco de dados MySQL 8
# formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://root:root@localhost:3306/inforcell_os"

# Autenticação (RNF02/RNF03) — troque por uma frase longa e aleatória
JWT_SECRET=troque-por-uma-chave-secreta-longa
JWT_EXPIRES_IN=8h

# Inteligência Artificial — API da Anthropic
# Crie a chave em https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
